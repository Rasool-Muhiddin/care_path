# /etc/systemd/system/axon-flush-tokens.service
# يحذف refresh tokens المنتهية من جداول token_blacklist (تكبر مع كل تجديد
# وتسجيل خروج بسبب BLACKLIST_AFTER_ROTATION). يشغّله axon-flush-tokens.timer.
[Unit]
Description=Axon - flush expired JWT refresh tokens
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=axon
Group=www-data
WorkingDirectory=/var/www/axon/app
EnvironmentFile=/etc/axon/axon.env
ExecStart=/var/www/axon/venv/bin/python manage.py flushexpiredtokens
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
