# انسخه إلى: محلياً .env  |  السيرفر /etc/axon/axon.env  (لا ترفع الملف الحقيقي إلى Git)
# لا تضع علامات اقتباس ولا مسافات حول = . ولّد كلمات المرور بـ: openssl rand -hex 24

# --- عام ---
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=axon.tera-software1.com
CSRF_TRUSTED_ORIGINS=https://axon.tera-software1.com
# أصول ويب مسموحة (اتركه فارغاً: تطبيقات أندرويد لا تحتاج CORS)
CORS_ALLOWED_ORIGINS=

# --- قاعدة البيانات ---
DB_ENGINE=postgres
DB_NAME=axon_db
DB_USER=axon_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- HTTPS ---
SECURE_SSL_REDIRECT=True
# ابدأ بـ 3600 ثم ارفعها إلى 31536000 بعد التأكد أن كل شيء يعمل
SECURE_HSTS_SECONDS=3600

# --- Firebase (الملف خارج المشروع) ---
FIREBASE_CREDENTIALS_PATH=/etc/axon/firebase-service-account.json

# --- مسارات السيرفر ---
STATIC_ROOT=/var/www/axon/static
MEDIA_ROOT=/var/www/axon/media

# --- اختياري ---
# THROTTLE_ANON=60/min
# THROTTLE_USER=1200/min
# LOG_LEVEL=INFO
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
