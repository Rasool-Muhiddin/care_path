+        model = AppVersion
+        fields = [
+            "platform",
+            "version_name",
+            "version_code",
+            "release_notes",
+            "is_mandatory",
+            "download_link",
+        ]
+
+    def get_download_link(self, obj: AppVersion) -> str:
+        request = self.context.get("request")
+        return obj.download_link(request)
